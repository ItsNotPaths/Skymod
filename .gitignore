vendor/

# compiled shaders
src/render/shaders/*.spv

# baked input-prompt atlas (build/bake_prompts.sh)
src/prompts/prompts.pak

# build outputs
build/out

# dev-tool sources stay local; their binaries land in the repo root

/nifdump
/esmdump
/pexdump
/swfdump

# local run helper
/quicktest.sh

# profiling / editor artifacts
/profile_*.html
imgui.ini

# golden tests: local-install data only
tests/golden/**
!tests/golden/.gitkeep

# design docs are local-only — only the root README is tracked
*.md
!/README.md
docs/

*.log
/logs/
*.o
