+LUA_API void lua_setfalsy (lua_State *L, int idx, int falsy) {  /* falsy */
+  TValue *o;
+  lua_lock(L);
+  o = index2value(L, idx);
+  api_check(L, ttisfulluserdata(o), "full userdata expected");
+  uvalue(o)->falsy = (falsy != 0);
+  lua_unlock(L);
+}
