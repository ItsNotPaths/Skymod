+/* papyrus-eq: ASCII case-insensitive string equality */
+#define asciilower(c)	((c) >= 'A' && (c) <= 'Z' ? (c) + ('a' - 'A') : (c))
+
+static int eqfold (const TValue *t1, const TValue *t2) {
+  const TString *a = tsvalue(t1), *b = tsvalue(t2);
+  const char *s1 = getstr(a), *s2 = getstr(b);
+  size_t i, len = tsslen(a);
+  if (len != tsslen(b)) return 0;
+  for (i = 0; i < len; i++)
+    if (asciilower(s1[i]) != asciilower(s2[i])) return 0;
+  return 1;
+}
+
