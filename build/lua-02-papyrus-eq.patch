+/* papyrus-eq: '__eq' of any value, not only tables and full userdata */
+static const TValue *eqtm (lua_State *L, const TValue *o) {
+  Table *mt;
+  switch (ttype(o)) {
+    case LUA_TTABLE: mt = hvalue(o)->metatable; break;
+    case LUA_TUSERDATA: mt = uvalue(o)->metatable; break;
+    default: mt = G(L)->mt[ttype(o)];
+  }
+  return fasttm(L, mt, TM_EQ);
+}
